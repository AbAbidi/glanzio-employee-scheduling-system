# PostgreSQL connection used by the NestJS application and Prisma CLI.
DATABASE_URL="postgresql://esms_dev_user:replace_with_local_password@localhost:5432/esms_dev?schema=public"

# Authentication and browser security.
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"
INVITATION_EXPIRES_IN_HOURS="72"
AUTH_MAX_FAILED_ATTEMPTS="5"
AUTH_LOCK_MINUTES="15"

# Local server and allowed browser frontend origins (comma-separated).
NODE_ENV="development"
PORT="3000"
CORS_ORIGIN="http://localhost:5173"
# OVH/Nginx on this same machine: set loopback. Never trust arbitrary proxies.
TRUST_PROXY="false"
# Public origin used in manually shared invitation links; HTTPS in production.
PUBLIC_FRONTEND_URL="http://localhost:5173"

# Quote delivery. Email Pro hostname must be read from the actual OVH service;
# do not guess pro1/pro2 and do not commit real credentials.
SMTP_ENABLED="false"
# SMTP_HOST="your-email-pro-host-from-ovh"
SMTP_PORT="587"
# SMTP_USER="info@glanzio-reinigung.de"
# SMTP_PASSWORD="configure-only-in-private-server-environment"
SMTP_FROM="info@glanzio-reinigung.de"

# Full test-data cleanup is available automatically outside production.
# Production always disables test resets, even if this legacy flag is true.
ALLOW_TEST_WORKSPACE_RESET="false"

# Scheduling/reporting policy. Student assignments remain allowed above the limit.
SYSTEM_TIME_ZONE="Europe/Paris"
# October 2026+ uses the versioned simulation policy in student-accounting.ts.
STUDENT_MONTHLY_LIMIT_MINUTES="2400"

# Professional payment-statement header. Replace these before production use.
PAYROLL_COMPANY_LEGAL_NAME="glanzio-reinigung"
PAYROLL_COMPANY_ADDRESS="Street, postal code, city, country"
PAYROLL_COMPANY_REGISTRATION="Commercial registration number"
PAYROLL_CURRENCY="EUR"

# Address lookup and driving-route estimates used by the assignment calendar.
# Public defaults are suitable for light local development. Use a managed or
# self-hosted provider before production traffic.
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"
ROUTING_BASE_URL="https://router.project-osrm.org"
GEOCODING_USER_AGENT="ClarityCleanScheduling/1.0 (replace-with-contact-email)"

# Used only by `npx prisma db seed`; never commit real values.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
