{
  "name": "esms-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node tools/fix-vinext-windows-cache.mjs",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:auth && npm run test:holidays && npm run test:preferences && npm run test:glass && npm run test:pagination && npm run build && node --test tests/rendered-html.test.mjs",
    "test:pagination": "node --experimental-strip-types --test tests/paginated-items.test.mjs tests/calendar-layout.test.mjs",
    "test:glass": "node --experimental-strip-types --test tests/glass-cleaning.test.mjs",
    "test:preferences": "node --experimental-strip-types --test tests/cookie-preferences.test.mjs",
    "test:holidays": "node --experimental-strip-types --test tests/public-holidays.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth-client.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.20",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cypress": "^15.20.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "image-size": "2.0.4",
    "undici": "7.30.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    }
  },
  "type": "module"
}
